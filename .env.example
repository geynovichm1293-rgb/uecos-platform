# Database
# Used by docker-compose.yml; choose a strong local-only development password.
POSTGRES_ADMIN_USER=uecos_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
APP_DB_USER=uecos_app
APP_DB_PASSWORD=replace-with-a-strong-local-app-password
PGHOST=localhost
PGPORT=5432
PGUSER=uecos_app
PGPASSWORD=replace-with-a-strong-local-app-password
PGDATABASE=uecos_dev
# Alternatively set DATABASE_URL to a URL-encoded connection string.
DATABASE_POOL_SIZE=10

# Server
# Set to the exact number of trusted reverse proxies in front of Express (0 disables proxy trust).
TRUST_PROXY_HOPS=0
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Authentication
# Optional: set both values to create a local seed administrator. No default admin is created.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRY=24h
SESSION_TIMEOUT=30m

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# AI/LLM Integration
AI_PROVIDER=openai
AI_API_KEY=sk_test_xxxxx
AI_MODEL=gpt-4
AI_TIMEOUT=30000
AI_MAX_TOKENS=2000
AI_COST_LIMIT_USD=100

# Email (future)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.xxxxx

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# Backup
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
