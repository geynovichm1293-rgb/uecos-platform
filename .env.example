# PostgreSQL Docker Compose administrator (used only to initialize the database)
POSTGRES_ADMIN_USER=uecos_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# Non-superuser role used by the API and migrations
APP_DB_USER=uecos_app
APP_DB_PASSWORD=replace-with-a-strong-local-app-password

# Local direct-Node connection; Docker Compose supplies its own container settings
PGHOST=localhost
PGPORT=5432
PGUSER=uecos_app
PGPASSWORD=replace-with-a-strong-local-app-password
PGDATABASE=uecos_dev
# Alternatively set DATABASE_URL to a URL-encoded PostgreSQL connection string.
DATABASE_POOL_SIZE=10

# Server
PORT=3000
NODE_ENV=development
# Set to the exact number of trusted reverse proxies; 0 disables proxy trust.
TRUST_PROXY_HOPS=0

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRY=24h
BCRYPT_ROUNDS=12
# Optional separate HMAC key for rate-limit identifiers; falls back to JWT_SECRET.
# RATE_LIMIT_HASH_SECRET=

# Optional local seed administrator. Both values are required; no default admin is created.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
