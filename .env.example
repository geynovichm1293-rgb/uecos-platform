# Database
DATABASE_URL=postgres://user:password@localhost:5432/uecos_dev
DATABASE_POOL_SIZE=10

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRY=24h
SESSION_TIMEOUT=30m

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# AI/LLM Integration
AI_PROVIDER=openai
AI_API_KEY=sk_test_xxxxx
AI_MODEL=gpt-4
AI_TIMEOUT=30000
AI_MAX_TOKENS=2000
AI_COST_LIMIT_USD=100

# Email (future)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=SG.xxxxx

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# Backup
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
